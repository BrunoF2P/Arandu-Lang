//! ASCII byte classification and case conversion.
//!
//! ## Overview
//!
//! Classify ASCII letters, digits, and whitespace, or change the case of ASCII letters. Functions operate on bytes and leave nonmatching bytes unchanged.
//!
//! ## Example
//!
//! ```arandu
//! import std.core.ascii as ascii
//!
//! let digit = ascii.isAsciiDigit(b'7')
//! let lower = ascii.toAsciiLower(b'A')
//! ```
//!
//! ## Complexity
//! Every operation takes O(1) time and O(1) space.
//!
//! ## Allocations
//! None. Non-ASCII bytes pass through case conversion unchanged.
//!
//! ## Platform
//! `native` · `wasm32` · `bare-metal`

module std.core.ascii

/// Returns `true` if the byte represents an ASCII alphabetic character (`a-z` or `A-Z`).
///
/// # Examples
/// ```arandu
/// ascii.isAsciiAlpha(b'a') // true
/// ascii.isAsciiAlpha(b'Z') // true
/// ascii.isAsciiAlpha(b'9') // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isAsciiAlpha(b: u8): bool {
    let lower = (b >= b'a') && (b <= b'z')
    let upper = (b >= b'A') && (b <= b'Z')
    return lower || upper
}

/// Returns `true` if the byte represents an ASCII decimal digit (`0-9`).
///
/// # Examples
/// ```arandu
/// ascii.isAsciiDigit(b'5') // true
/// ascii.isAsciiDigit(b'a') // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isAsciiDigit(b: u8): bool {
    return (b >= b'0') && (b <= b'9')
}

/// Returns `true` if the byte represents an ASCII alphanumeric character (`a-z`, `A-Z`, or `0-9`).
///
/// # Examples
/// ```arandu
/// ascii.isAsciiAlphanumeric(b'A') // true
/// ascii.isAsciiAlphanumeric(b'3') // true
/// ascii.isAsciiAlphanumeric(b'$') // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isAsciiAlphanumeric(b: u8): bool {
    return isAsciiAlpha(b) || isAsciiDigit(b)
}

/// Returns `true` if the byte represents an ASCII whitespace character
/// (space `' '`, tab `\t`, newline `\n`, or carriage return `\r`).
///
/// # Examples
/// ```arandu
/// ascii.isAsciiWhitespace(b' ')  // true
/// ascii.isAsciiWhitespace(b'\n') // true
/// ascii.isAsciiWhitespace(b'a')  // false
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func isAsciiWhitespace(b: u8): bool {
    return b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'
}

/// Converts an ASCII uppercase byte (`A-Z`) to its corresponding lowercase form (`a-z`).
/// Non-uppercase bytes are returned unchanged.
///
/// # Examples
/// ```arandu
/// ascii.toAsciiLower(b'A') // b'a' (97)
/// ascii.toAsciiLower(b'a') // b'a' (97)
/// ascii.toAsciiLower(b'1') // b'1' (49)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func toAsciiLower(b: u8): u8 {
    if (b >= b'A') && (b <= b'Z') {
        return b + 32
    }
    return b
}

/// Converts an ASCII lowercase byte (`a-z`) to its corresponding uppercase form (`A-Z`).
/// Non-lowercase bytes are returned unchanged.
///
/// # Examples
/// ```arandu
/// ascii.toAsciiUpper(b'a') // b'A' (65)
/// ascii.toAsciiUpper(b'A') // b'A' (65)
/// ascii.toAsciiUpper(b'!') // b'!' (33)
/// ```
///
/// # Complexity
/// Time: O(1) | Space: O(1)
public func toAsciiUpper(b: u8): u8 {
    if (b >= b'a') && (b <= b'z') {
        return b - 32
    }
    return b
}